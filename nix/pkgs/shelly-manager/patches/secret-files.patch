diff --git a/src/core/settings.py b/src/core/settings.py
index d41a5d1..17746ad 100644
--- a/src/core/settings.py
+++ b/src/core/settings.py
@@ -7,7 +7,7 @@ import os
 from pathlib import Path
 from typing import Any
 
-from pydantic import Field, field_validator
+from pydantic import Field, field_validator, model_validator
 from pydantic_settings import BaseSettings, SettingsConfigDict
 
 from core.domain.entities.exceptions import ConfigurationError, ValidationError
@@ -211,6 +211,36 @@ class AppSettings(BaseSettings):
         exclude=True,  # Prevent secret from being logged
     )
 
+    # The FOO / FOO_FILE convention: SHELLY_SECRET_KEY_FILE and
+    # SHELLY_AUTH_TOKEN_FILE name files holding the secret, so that it need
+    # not be passed in the environment.
+    secret_key_file: str | None = Field(
+        default=None,
+        description="File holding secret_key, if secret_key is not set.",
+    )
+
+    auth_token_file: str | None = Field(
+        default=None,
+        description="File holding auth_token, if auth_token is not set.",
+    )
+
+    @model_validator(mode="after")
+    def _read_secret_files(self) -> "AppSettings":
+        for name in ("secret_key", "auth_token"):
+            path = getattr(self, f"{name}_file")
+            if path is None:
+                continue
+            variable = f"SHELLY_{name.upper()}"
+            if getattr(self, name) is not None:
+                raise ValueError(f"{variable} and {variable}_FILE are both set")
+            try:
+                value = Path(path).read_text(encoding="utf-8")
+            except OSError as e:
+                raise ValueError(f"{variable}_FILE: cannot read {path}: {e}") from e
+            # Files usually end with a newline that is not part of the secret.
+            setattr(self, name, value.rstrip("\r\n"))
+        return self
+
     def __init__(self, **kwargs: Any) -> None:
         super().__init__(**kwargs)
         self._load_config_file()
diff --git a/tests/unit/test_settings.py b/tests/unit/test_settings.py
index 08bd59c..2178823 100644
--- a/tests/unit/test_settings.py
+++ b/tests/unit/test_settings.py
@@ -210,3 +210,41 @@ def test_it_retries_a_scanned_address_once_by_default(monkeypatch):
 
     assert network.retry_attempts == 1
     assert network.retry_delay == 0.5
+
+
+KEY = "0N6fK7YkEmvA0I4d1sD4v15uvB94H4A1N1nMG8vLMOg="
+
+
+def test_it_reads_secrets_from_files(tmp_path, monkeypatch):
+    key_file = tmp_path / "secret-key"
+    key_file.write_text(KEY + "\n")
+    token_file = tmp_path / "auth-token"
+    token_file.write_text("token\n")
+    monkeypatch.delenv("SHELLY_SECRET_KEY", raising=False)
+    monkeypatch.delenv("SHELLY_AUTH_TOKEN", raising=False)
+    monkeypatch.setenv("SHELLY_SECRET_KEY_FILE", str(key_file))
+    monkeypatch.setenv("SHELLY_AUTH_TOKEN_FILE", str(token_file))
+
+    settings = AppSettings(config_file=str(tmp_path / "config.json"))
+
+    assert settings.secret_key == KEY
+    assert settings.auth_token == "token"
+    settings.validate_settings()
+
+
+def test_it_refuses_a_secret_given_twice(tmp_path, monkeypatch):
+    key_file = tmp_path / "secret-key"
+    key_file.write_text(KEY)
+    monkeypatch.setenv("SHELLY_SECRET_KEY", KEY)
+    monkeypatch.setenv("SHELLY_SECRET_KEY_FILE", str(key_file))
+
+    with pytest.raises(ValueError, match="SHELLY_SECRET_KEY and SHELLY_SECRET_KEY_FILE"):
+        AppSettings(config_file=str(tmp_path / "config.json"))
+
+
+def test_it_reports_an_unreadable_secret_file(tmp_path, monkeypatch):
+    monkeypatch.delenv("SHELLY_AUTH_TOKEN", raising=False)
+    monkeypatch.setenv("SHELLY_AUTH_TOKEN_FILE", str(tmp_path / "missing"))
+
+    with pytest.raises(ValueError, match="SHELLY_AUTH_TOKEN_FILE: cannot read"):
+        AppSettings(config_file=str(tmp_path / "config.json"))
